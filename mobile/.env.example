# API base URL the mobile app talks to. See src/api/config.ts for the
# default it falls back to when this is unset (127.0.0.1:8124 on iOS,
# 10.0.2.2:8124 on the Android emulator) — that default only works for a
# simulator/emulator on the SAME machine as the backend. A physical device
# on the same Wi-Fi needs the host machine's real LAN IP here instead, e.g.:
#
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:8124/api/v1
#
# Find your machine's LAN IP with `ipconfig` (Windows) / `ifconfig` (macOS/
# Linux) — look for the adapter with a real gateway, not a VPN/virtual one.
# This value is NOT secret (no credentials in it) but is machine-specific,
# which is why it's a local .env rather than committed directly into
# app.config.ts.
EXPO_PUBLIC_API_BASE_URL=
