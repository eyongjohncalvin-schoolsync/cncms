# CNCMS production .env — copy to `.env`, fill the blanks, then
# `php artisan key:generate --force`. See DEPLOYMENT.md.

APP_NAME=CNCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database: PostgreSQL 18 on this same server ---------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cncms
DB_USERNAME=cncms
DB_PASSWORD=

# Tenancy resolves the tenant from the logged-in user, not the domain, so
# this only feeds PreventAccessFromCentralDomains. Derived from APP_URL when
# blank — set only if the served host differs from APP_URL.
CENTRAL_DOMAIN=

# --- Sessions / cache / queue: all database-backed (no Redis needed) ------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.YOUR_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sanctum: the web admin uses cookie/session auth; the mobile app uses
# bearer tokens. Keep the domain here in sync with SESSION_DOMAIN's host.
SANCTUM_STATEFUL_DOMAINS=YOUR_DOMAIN

# --- Mail: a real transactional provider ---------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@YOUR_DOMAIN"
MAIL_FROM_NAME="CNCMS"

# --- Self-service Google sign-in (optional) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/auth/google/callback

# --- Expo push (optional — Expo's push API works without it) -------------
EXPO_ACCESS_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Encrypts Inertia's browser-side history cache (defense in depth alongside
# Inertia::clearHistory() on logout).
INERTIA_ENCRYPT_HISTORY=true

# AWS/S3 unused in this deployment (files stay on local disk).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
