APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Self-service Google sign-up/sign-in (Laravel Socialite). Provision real
# credentials in Google Cloud Console — these are unset placeholders, not
# real-looking fake values. GOOGLE_REDIRECT_URI must match the app's
# /auth/google/callback route exactly (e.g. http://localhost:8000/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Expo push notifications (App\Services\ExpoPushService). Optional — Expo's
# push API works unauthenticated; set this only to enable Expo's "Enhanced
# Security" mode. Unset placeholder, not a real-looking fake value.
EXPO_ACCESS_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Encrypts Inertia's browser-side history.state cache so page props aren't
# left readable there after logout (defense in depth alongside
# Inertia::clearHistory() in AuthController::destroy()). Read directly by
# config/inertia.php's 'history.encrypt' — no middleware registration needed.
INERTIA_ENCRYPT_HISTORY=true
